/**
 * This ruleset enforces a strict user-ownership model for the iFrame Manager
 * application. It ensures that users can only access and manage their own data,
 * while providing read-only access for admins.
 *
 * Core Philosophy:
 * The security model is built on path-based authorization and user roles.
 * A user's unique ID (UID) from Firebase Authentication is used as the document 
 * key in the `/users` collection.
 * Admins have special privileges to manage all user data.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information.
 *
 * Key Security Decisions:
 * - User Isolation: A user can only ever read or write their own data.
 * - Admin Privileges: A user with the 'admin' role can read all user data.
 * - No Public User Listing: To protect user privacy, listing all documents in
 *   the `/users` collection is only permitted for admins.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to improve readability and reuse of logic.

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     * This is the core of the ownership-based security model.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    /**
     * Checks if the user has the 'admin' role by reading their user document.
     * This should only be used in rules where the cost of an extra read is acceptable.
     */
    function isAdmin() {
      // Security rule cost: This rule requires one document read.
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    /**
     * @description Manages user profile documents. Only the owner can access their own document. Admins can read/list all users.
     * @path /users/{userId}
     * @allow (get) An authenticated user reads their own profile, or an admin reads any profile.
     * @allow (list) An admin user lists all users in the system.
     * @deny (list) A non-admin user attempts to list all users in the system.
     * @allow (create) An authenticated user creates their own profile document.
     * @allow (update) An authenticated user updates their own profile, or an admin updates any profile.
     * @allow (delete) An admin deletes a user profile.
     * @principle Restricts access to a user's own data tree, but allows admins full read/write access. Prevents user enumeration for non-admins.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
